[Unit]
Description=OpenCode Mobile Bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/jakeseol/.openclaw/workspace/opencode-mobile/bridge
Environment=PORT=7350
Environment=OPENCODE_BRIDGE_MODE=process
Environment=OPENCODE_CMD=opencode
Environment=OPENCODE_ARGS=run --format json
Environment=OPENCODE_BRIDGE_STATE_PATH=/home/jakeseol/.openclaw/workspace/opencode-mobile/bridge/data/sessions.json
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
